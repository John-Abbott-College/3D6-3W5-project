{
  "$schema": "https://github.com/Azure/data-api-builder/releases/latest/download/dab.draft.schema.json",
  "data-source": {
    "database-type": "mssql",
    "connection-string": "@env('DAB_CONN')"
  },
  "runtime": {
    "rest": { "enabled": true, "path": "/api" },
    "graphql": { "enabled": false },
    "host": { "mode": "development" }
  },
  "entities": {
    "StoredFile": {
      "source": { "object": "dbo.StoredFile", "type": "table" },
      "permissions": [
        { "role": "anonymous", "actions": ["create", "read", "delete"] }
      ]
    }
  }
}
