# Copy to .env (setup.bat does this for you) and edit for THIS machine.
# .env is git-ignored. Never commit real passwords.

# Server name used by rebuild-db.bat (sqlcmd). Pick ONE:
# DB_SERVER=JAC-1G1X6G4\MSSQLSERVER1
# DB_SERVER=localhost
# DB_SERVER=localhost\SQLEXPRESS
DB_SERVER=(localdb)\MSSQLLocalDB

# Connection string used by DAB. Keep Server= the same as DB_SERVER above.
DAB_CONN=Server=localhost;Database=Project3D6;Trusted_Connection=True;TrustServerCertificate=True;
